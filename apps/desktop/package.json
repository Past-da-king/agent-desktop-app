{
  "name": "@agent/desktop",
  "version": "0.2.31",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "make:icons": "node ../../scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@openai/codex-sdk": "^0.163.0"
  },
  "devDependencies": {
    "@agent/core": "*",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "author": "Agent",
  "description": "A desktop home for your agent."
}
